```gitignore
# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example
!.env.sample

# =========================
# Python / FastAPI Backend
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# =========================
# React / Node.js Frontend
# =========================
node_modules/
dist/
build/
.next/
.nuxt/
.output/
coverage/
.vite/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# IDEs / Editors
# =========================
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo

# =========================
# Operating System
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Databases / Backups
# =========================
*.sqlite
*.sqlite3
*.db
*.bak
*.dump

# =========================
# Secrets / Credentials
# =========================
secrets/
credentials.json
service-account*.json
*.pem
*.key

# =========================
# Temporary Files
# =========================
tmp/
temp/
*.tmp
*.temp
